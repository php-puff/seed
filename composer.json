{
    "name": "puff/seed",
    "description": "Explicit database seed runner for Puff",
    "type": "library",
    "keywords": ["database", "seed", "puff"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "puff/config": "dev-main",
        "puff/console": "dev-main",
        "puff/database": "dev-main",
        "puff/di": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Puff\\Seed\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Puff\\Seed\\Tests\\": "tests/"}
    },
    "extra": {
        "puff": {
            "config": {"seed.php": "config/seed.php"},
            "providers": ["Puff\\Seed\\ServiceProvider"],
            "commands": ["Puff\\Seed\\ConsoleProvider"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {"preferred-install": "dist", "sort-packages": true},
    "scripts": {
        "analyse": "phpstan analyse src tests --level=8 --no-progress --memory-limit=1G",
        "test": "phpunit tests"
    }
}
